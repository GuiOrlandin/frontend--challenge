{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src e2e vite.config.ts playwright.config.ts eslint.config.js",
    "format": "pnpm prettier --write",
    "format:check": "pnpm prettier --check",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "docker run --rm --ipc=host -v .:/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.0-noble sh -c \"npm i -g pnpm@12.18.0 && pnpm install --frozen-lockfile && pnpm exec playwright test --grep @visual --pass-with-no-tests\"",
    "test:visual:update": "docker run --rm --ipc=host -v .:/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.0-noble sh -c \"npm i -g pnpm@12.18.0 && pnpm install --frozen-lockfile && pnpm exec playwright test --grep @visual --pass-with-no-tests --update-snapshots\"",
    "images": "node scripts/optimize-images.mjs",
    "prettier": "prettier \"src/**/*.{ts,tsx,css}\" vite.config.ts playwright.config.ts \"e2e/**/*.ts\" eslint.config.js index.html \"tsconfig*.json\" package.json .prettierrc.json"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "0.2.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "~5.107.1",
    "@tanstack/react-router": "~1.170.46",
    "axios": "~1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "msw": "~2.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "~4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tanstack/router-plugin": "~1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "shadcn": "4.23.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
